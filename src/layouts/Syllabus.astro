---
import "../styles/syllabus.css";

interface Props {
  title: string;
  description: string;
  jsonLd?: unknown;
}

const { title, description, jsonLd } = Astro.props;
const path = Astro.url.pathname;
const origin = "https://www.akademiamlm.pl";
const canonical = new URL(path, origin).href;
const links = [
  { href: "/wyklad/", label: "Wykłady" },
  { href: "/szkola/", label: "O szkole" },
  { href: "/poczta/", label: "Poczta" },
];

function current(href: string) {
  if (href === "/wyklad/") return path.startsWith("/wyklad");
  return path === href;
}
---

<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible:wght@400;700&family=Source+Serif+4:opsz,wght@8..60,600;8..60,700&display=swap"
      rel="stylesheet"
    />
    {
      jsonLd && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(jsonLd).replace(/</g, "\\u003c")}
        />
      )
    }
  </head>
  <body>
    <a class="am-skip" href="#tresc">Przejdź do treści</a>
    <div class="am-wrap">
      <header class="am-bar">
        <a class="am-brand" href="/">Akademia MLM</a>
        <nav class="am-nav" aria-label="Szkoła">
          {
            links.map((link) => (
              <a href={link.href} aria-current={current(link.href) ? "page" : undefined}>
                {link.label}
              </a>
            ))
          }
        </nav>
      </header>
      <main id="tresc">
        <slot />
      </main>
      <footer class="am-foot">
        <p>Akademia MLM. Ewa Lasek. To nie jest firma sprzedażowa.</p>
        <p><a href="/prywatnosc/">Prywatność</a></p>
      </footer>
    </div>
  </body>
</html>
