---
import "../styles/syllabus.css";

interface Props {
  title: string;
  description: string;
  jsonLd?: unknown;
}

const { title, description, jsonLd } = Astro.props;
const path = Astro.url.pathname;
const origin = "https://www.akademiamlm.pl";
const canonical = new URL(path, origin).href;
const links = [
  { href: "/wyklad/", label: "Wykłady" },
  { href: "/lista/", label: "Lista" },
  { href: "/slowa/", label: "Słowa" },
  { href: "/szkola/", label: "O szkole" },
  { href: "/poczta/", label: "Poczta" },
];

function current(href: string) {
  if (href === "/wyklad/") return path.startsWith("/wyklad");
  return path === href || path.startsWith(href);
}

const siteLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Akademia MLM",
  url: origin + "/",
  description: "Szkoła czytania planów wynagrodzeń. Bez zestawu startowego i bez obietnicy wypłaty.",
  inLanguage: "pl-PL",
  publisher: {
    "@type": "Organization",
    name: "Akademia MLM",
    url: origin + "/",
  },
};
---

<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:type" content="website" />
    <meta name="robots" content="index,follow" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:ital,wght@0,400;0,500;0,600;1,400&family=Literata:opsz,wght@7..72,600;7..72,650;7..72,700&display=swap"
      rel="stylesheet"
    />
    <script type="application/ld+json" set:html={JSON.stringify(siteLd).replace(/</g, "\\u003c")} />
    {
      jsonLd && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(jsonLd).replace(/</g, "\\u003c")}
        />
      )
    }
  </head>
  <body>
    <a class="am-skip" href="#tresc">Przejdź do treści</a>
    <div class="am-wrap">
      <header class="am-bar">
        <a class="am-brand" href="/">Akademia MLM</a>
        <nav class="am-nav" aria-label="Szkoła">
          {
            links.map((link) => (
              <a href={link.href} aria-current={current(link.href) ? "page" : undefined}>
                {link.label}
              </a>
            ))
          }
        </nav>
      </header>
      <main id="tresc">
        <slot />
      </main>
      <footer class="am-foot">
        <p>Akademia MLM. Ewa Lasek. To nie jest firma sprzedażowa i nie oferuje zestawów startowych.</p>
        <p>
          <a href="/lista/">Lista przed spotkaniem</a>
          {" · "}
          <a href="/slowa/">Słowa ze slajdu</a>
          {" · "}
          <a href="/prywatnosc/">Prywatność</a>
        </p>
      </footer>
    </div>
    <script defer src="https://umami-pink-phi.vercel.app/script.js" data-website-id="d2f29973-4534-4013-af20-2d24869069c7" data-domains="akademiamlm.pl,www.akademiamlm.pl"></script>
  </body>
</html>
